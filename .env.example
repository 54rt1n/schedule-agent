# Environment variables for scheduling_agent

# FastAPI/Uvicorn
# HOST=0.0.0.0
# PORT=8000
# RELOAD=false

# Core Settings
DATABASE_URL="sqlite+aiosqlite:///./schedule_agent.db"
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEFAULT_TIMEZONE=UTC
LOG_LEVEL=INFO

# Authentication
# Generate a strong, random secret key for production
JWT_SECRET_KEY=your-secret-key-here
JWT_ISSUER=scheduling-agent
# Comma-separated list of valid API keys
API_KEYS=key1,key2,key3
# Basic auth credentials (if needed, though JWT/API keys preferred for A2A)
# AUTH_USERNAME=admin
# AUTH_PASSWORD=securepassword

# LLM Integration
LLM_API_KEY=your-featherless-api-key-here # Changed to Featherless
# Base URL for the LLM API endpoint
LLM_BASE_URL=https://api.featherless.ai/v1 # Changed to Featherless endpoint
# Example for local Ollama server:
# LLM_BASE_URL=http://localhost:11434/v1
# Example for local LM Studio server:
# LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3-0324 # Changed to DeepSeek V3

# Performance Settings
MAX_CONCURRENT_CONNECTIONS=20
QUERY_TIMEOUT_SECONDS=30
DATABASE_POOL_SIZE=10
# Set DB_ECHO=true for verbose SQLAlchemy logging
# DB_ECHO=false

# LLM Provider Configuration (Example for OpenAI)
# OPENAI_API_KEY="your-api-key"
# LLM_MODEL="gpt-4"

# JWT Secret Key (Generate a strong random key)
# JWT_SECRET_KEY="your-secret-key"
# JWT_ALGORITHM="HS256" # Consider EdDSA as mentioned in plan

# Logging Level
# LOG_LEVEL=INFO 